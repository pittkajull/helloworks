# Salin file ini jadi `.env` lalu isi API key kamu (file .env TIDAK ikut di-commit).
# Daftar di OpenRouter → https://openrouter.ai/keys (pakai model :free, gratis).

# WAJIB — API key OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Opsional
# PORT=8787
# CHAT_MODEL=google/gemma-4-26b-a4b-it:free   ← model :free yang lagi aktif (cek: openrouter.ai/models?fmt=free)
# CHAT_FALLBACK_MODELS=google/gemma-4-31b-it:free,openai/gpt-oss-20b:free   ← cadangan auto-fallback pas 429/5xx
# SITE_URL=http://localhost:5173
